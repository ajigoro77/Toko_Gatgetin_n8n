        "jsCode": "let text = \"Daftar Produk:\\n\\n\";\n\nfor (const item of items) {\n\n  const nama = item.json[\"Nama_Produk\"];\n  const stok = item.json[\"Stok\"];\n  const harga = item.json[\"Harga\"];\n\n  text += `• ${nama} | stok: ${stok} | harga: ${harga}\\n`;\n}\n\nreturn [\n  {\n    json: {\n      text: text\n    }\n  }\n];"
